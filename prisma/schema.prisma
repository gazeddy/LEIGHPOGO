generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int            @id @default(autoincrement())
  name           String?
  ign            String         @unique
  password       String
  entries        Entry[]
  role           String         @default("user")
  searchStrings  SearchString[]
  pokedexEntries PokedexEntry[]
  tradeListings  TradeListing[]
  wantedTrades   WantedTrade[]
}

model Entry {
  id          Int      @id @default(autoincrement())
  trainerName String
  code        String
  team        String   @default("MYSTIC")
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SearchString {
  id        Int      @id @default(autoincrement())
  title     String
  query     String
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PokedexEntry {
  id        Int      @id @default(autoincrement())
  dexNumber Int
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, dexNumber])
}

model TradeListing {
  id        Int                @id @default(autoincrement())
  ownerId   Int
  owner     User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  location  String?
  notes     String?
  status    String             @default("ACTIVE")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  expiresAt DateTime
  items     TradeListingItem[]

  @@index([status, expiresAt])
  @@index([ownerId, createdAt])
}

model TradeListingItem {
  id          Int          @id @default(autoincrement())
  listingId   Int
  listing     TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  direction   String
  pokemonName String
  shiny       Boolean      @default(false)
  costume     Boolean      @default(false)
  background  Boolean      @default(false)
  dynamax     Boolean      @default(false)
  gigantamax  Boolean      @default(false)
  notes       String?

  @@index([listingId, direction])
}

model WantedTrade {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dexNumber   Int
  pokemonName String
  shiny       Boolean  @default(false)
  lucky       Boolean  @default(false)
  xxl         Boolean  @default(false)
  xxs         Boolean  @default(false)
  costume     Boolean  @default(false)
  background  Boolean  @default(false)
  dynamax     Boolean  @default(false)
  gigantamax  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pokemonName, createdAt])
  @@index([ownerId, createdAt])
}
