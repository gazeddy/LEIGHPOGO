generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int                          @id @default(autoincrement())
  name                        String?
  ign                         String                       @unique
  password                    String
  entries                     Entry[]
  role                        String                       @default("user")
  searchStrings               SearchString[]
  pokedexEntries              PokedexEntry[]
  tradeListings               TradeListing[]
  wantedTrades                WantedTrade[]
  tradeNotifications          TradeNotification[]
  pushSubscriptions           PushSubscription[]
  friendCodeGrabNotifications FriendCodeGrabNotification[] @relation("FriendCodeGrabOwner")
  friendCodeCopies            FriendCodeGrabNotification[] @relation("FriendCodeGrabActor")
  usageEvents                 UsageEvent[]
  tickerPreferences           UserTickerPreference[]
}

model UserTickerPreference {
  id         Int     @id @default(autoincrement())
  ownerId    Int
  owner      User    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tickerType String
  enabled    Boolean @default(true)

  @@unique([ownerId, tickerType])
  @@index([ownerId])
}

model Entry {
  id                          Int                          @id @default(autoincrement())
  trainerName                 String
  code                        String
  team                        String                       @default("MYSTIC")
  ownerId                     Int
  owner                       User                         @relation(fields: [ownerId], references: [id])
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  friendCodeGrabNotifications FriendCodeGrabNotification[]
}

model SearchString {
  id        Int      @id @default(autoincrement())
  title     String
  query     String
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PokedexEntry {
  id        Int      @id @default(autoincrement())
  dexNumber Int
  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, dexNumber])
}

model PokemonAvailabilityOverride {
  id        Int      @id @default(autoincrement())
  dexNumber Int      @unique
  released  Boolean
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PokemonRegionalOverride {
  id         Int      @id @default(autoincrement())
  dexNumber  Int      @unique
  isRegional Boolean  @default(false)
  regions    String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TradeListing {
  id                    Int                 @id @default(autoincrement())
  ownerId               Int
  owner                 User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  friendshipRequirement String              @default("ANY")
  location              String?
  notes                 String?
  status                String              @default("ACTIVE")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  expiresAt             DateTime
  items                 TradeListingItem[]
  notifications         TradeNotification[]

  @@index([status, expiresAt])
  @@index([ownerId, createdAt])
}

model TradeListingItem {
  id          Int          @id @default(autoincrement())
  listingId   Int
  listing     TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  direction   String
  pokemonName String
  shiny       Boolean      @default(false)
  lucky       Boolean      @default(false)
  xxl         Boolean      @default(false)
  xxs         Boolean      @default(false)
  costume     Boolean      @default(false)
  background  Boolean      @default(false)
  dynamax     Boolean      @default(false)
  gigantamax  Boolean      @default(false)
  notes       String?

  @@index([listingId, direction])
}

model WantedTrade {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dexNumber   Int
  pokemonName String
  shiny       Boolean  @default(false)
  lucky       Boolean  @default(false)
  xxl         Boolean  @default(false)
  xxs         Boolean  @default(false)
  costume     Boolean  @default(false)
  background  Boolean  @default(false)
  dynamax     Boolean  @default(false)
  gigantamax  Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pokemonName, createdAt])
  @@index([ownerId, createdAt])
}

model TradeNotification {
  id                    Int          @id @default(autoincrement())
  ownerId               Int
  owner                 User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  listingId             Int
  listing               TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type                   String       @default("WISHLIST_MATCH")
  pokemonName            String
  modifierSummary        String?
  matchedTrainerSummary  String?
  matchedTrainerCount    Int          @default(0)
  createdAt              DateTime     @default(now())
  readAt                 DateTime?

  @@unique([ownerId, listingId, pokemonName])
  @@index([ownerId, readAt, createdAt])
}

model FriendCodeGrabNotification {
  id         Int      @id @default(autoincrement())
  ownerId    Int
  owner      User     @relation("FriendCodeGrabOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  copiedById Int
  copiedBy   User     @relation("FriendCodeGrabActor", fields: [copiedById], references: [id], onDelete: Cascade)
  entryId    Int
  entry      Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  readAt     DateTime?

  @@index([ownerId, readAt, createdAt])
  @@index([copiedById, entryId, createdAt])
}

model UsageEvent {
  id        Int      @id @default(autoincrement())
  type      String
  ownerId   Int?
  owner     User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  path      String?
  device    String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([ownerId, createdAt])
}

model PushSubscription {
  id                      Int      @id @default(autoincrement())
  ownerId                 Int
  owner                   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  endpoint                String   @unique
  p256dh                  String
  auth                    String
  userAgent               String?
  timeZone                String   @default("Europe/London")
  lastRaidHourReminderKey String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([ownerId])
}

model RaidBossProfile {
  id               Int       @id @default(autoincrement())
  key              String    @unique
  category         String
  name             String
  pokemonId        Int?
  form             String?
  tier             String?
  types            String?
  weaknesses       String?
  resistances      String?
  boostedWeather   String?
  maxUnboostedCp   Int?
  maxBoostedCp     Int?
  possibleShiny    Boolean?
  refreshedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([category, name])
}

model RaidRotation {
  id        Int      @id @default(autoincrement())
  eventId   String   @unique
  category  String
  boss      String
  start     DateTime
  end       DateTime
  startRaw  String
  endRaw    String
  sourceUrl String?
  imageUrl  String?
  bossKeys  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, start])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
